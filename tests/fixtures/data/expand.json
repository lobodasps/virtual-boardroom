   "query": "marginal cost",
   "max": 12,
   "expected": []
  },
  {
   "name": "case-insensitive, terms already present are not added",
   "query": "GROSS MARGIN trend",
   "max": 12,
   "expected": [
    "GP%",
    "gross profit",
    "gross profit margin"
   ]
  },
  {
   "name": "the cap stops additions in group order",
