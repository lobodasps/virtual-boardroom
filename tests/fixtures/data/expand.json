{
 "cases": [
  {
   "name": "two groups in one question",
   "query": "What was our margin and DSO in 2025?",
   "max": 12,
   "expected": [
    "gross margin",
    "GP%",
    "gross profit",
    "gross profit margin",
    "days sales outstanding",
    "collection period",
    "receivable days"
   ]
  },
  {
